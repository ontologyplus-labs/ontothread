# Optional local Python configuration. Defaults work without this file.
FIG_DATABASE_URL=sqlite:///data/fixture.sqlite3
FIG_ARCHIVE_DIR=data/archive
FIG_SEC_CACHE_DIR=data/sec-cache
# Required only for live SEC ingestion: app name plus your real contact email.
SEC_USER_AGENT=
# Optional paid extraction. Both values are required; rules need neither.
OPENAI_API_KEY=
FIG_LLM_MODEL=
# Optional embedding reranking; enabled only when explicitly requested.
FIG_EMBEDDING_MODEL=text-embedding-3-small
FIG_EMBEDDING_CACHE_DIR=data/embedding-cache
# Optional graph projection when running Python against Docker services.
FIG_NEO4J_URI=bolt://127.0.0.1:7687
FIG_NEO4J_USER=neo4j
FIG_NEO4J_PASSWORD=
